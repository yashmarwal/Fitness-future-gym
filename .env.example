# ── Database (Supabase) ──────────────────────────────────────────────────
# Create a free project at https://supabase.com, run src/server/db/schema.sql
# in its SQL editor, then copy these from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs member/admin
# login cookies. Changing it logs everyone out.
SESSION_SECRET=

# ── WhatsApp Business Cloud API ─────────────────────────────────────────
# Needed for member login OTPs, fee reminders, birthday messages, and
# admin broadcasts. Without these, the app runs in "dev mode": OTP codes
# are logged to the server console (and returned in the API response)
# instead of sent over WhatsApp — everything else works normally.
# Set up via Meta Business Manager (or a BSP like Gupshup/AiSensy/Interakt).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — override the default template names below if yours differ
# from what's approved in Meta Business Manager:
WHATSAPP_TEMPLATE_OTP=ff_login_otp
WHATSAPP_TEMPLATE_FEE_REMINDER=ff_fee_reminder
WHATSAPP_TEMPLATE_BIRTHDAY=ff_birthday
WHATSAPP_TEMPLATE_ANNOUNCEMENT=ff_announcement

# ── Razorpay (fee payments) ───────────────────────────────────────────────
# From the Razorpay dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Settings → Webhooks, after adding https://yourdomain.com/api/fees/webhook
# (subscribe to the "payment.captured" event).
RAZORPAY_WEBHOOK_SECRET=

# ── Cron (Vercel Scheduled Functions) ────────────────────────────────────
# Any long random string. Vercel automatically sends it as a Bearer token
# to /api/cron/* routes when this env var is set on the project — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
