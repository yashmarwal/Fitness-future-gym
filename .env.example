# ── Database (Supabase) ──────────────────────────────────────────────────
# Create a free project at https://supabase.com, run src/backend/db/schema.sql
# in its SQL editor, then copy these from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs member/admin
# login cookies. Changing it logs everyone out.
SESSION_SECRET=

# ── WhatsApp Business Cloud API ─────────────────────────────────────────
# Used for exactly five things — login/signup OTPs, the signup welcome/card
# message, fee-due reminders, birthday messages, and admin-sent offers/gym
# updates (the broadcast tool). Not sent on every profile edit or payment —
# that was intentionally scoped back. Without these vars, the app runs in
# "dev mode": OTP codes are logged to the server console (and returned in
# the API response) instead of sent over WhatsApp — everything else works
# normally. Set up via Meta Business Manager (or a BSP like Gupshup/
# AiSensy/Interakt).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — override the default template names below if yours differ
# from what's approved in Meta Business Manager:
WHATSAPP_TEMPLATE_OTP=ff_login_otp
WHATSAPP_TEMPLATE_FEE_REMINDER=ff_fee_reminder
WHATSAPP_TEMPLATE_BIRTHDAY=ff_birthday
WHATSAPP_TEMPLATE_ANNOUNCEMENT=ff_announcement
WHATSAPP_TEMPLATE_WELCOME_CARD=ff_welcome_card
WHATSAPP_TEMPLATE_TRIAL_PASS=ff_trial_pass
WHATSAPP_TEMPLATE_TRIAL_REMINDER=ff_trial_reminder
WHATSAPP_TEMPLATE_ACCOUNT_BLOCKED=ff_account_blocked

# ── Email (Resend) ────────────────────────────────────────────────────────
# Same categories as WhatsApp, including OTP — both channels always fire
# Sign up at https://resend.com, verify a sending domain (or use their
# resend.dev test address while developing), and get an API key from the
# dashboard. Without RESEND_API_KEY, emails are logged to the console
# instead of sent — same dev-mode fallback pattern as WhatsApp.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fitness Future Gym <onboarding@resend.dev>

# ── Nutrition lookup (USDA FoodData Central) ─────────────────────────────
# Powers the auto-calorie-lookup in the member dashboard's food log — type a
# food name, pick a match, calories/protein/carbs/fat fill in automatically.
# Free forever, no cost. Works out of the box with no key at all (falls back
# to USDA's shared DEMO_KEY, which is rate-limited). For real use, get a
# free personal key at https://fdc.nal.usda.gov/api-key-signup (1,000
# requests/hour, no cost) and set it here.
USDA_FDC_API_KEY=

# ── Cron (Vercel Scheduled Functions) ────────────────────────────────────
# Any long random string. Vercel automatically sends it as a Bearer token
# to /api/cron/* routes when this env var is set on the project — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=

# ── Contact forms (Web3Forms) ────────────────────────────────────────────
# Powers the Location page's inquiry form (submits straight from the
# browser to Web3Forms — no backend route needed). Free forever, 250
# submissions/month on the free tier. Get a key at https://web3forms.com —
# NEXT_PUBLIC_ prefix is required (and correct here) since the form POSTs
# directly from the client; Web3Forms' own docs call for embedding this
# key client-side, spam protection is handled on their end.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────
# Real OS-level notifications for members who opt in from their dashboard —
# fee reminders, birthdays, admin broadcasts, account-blocked warnings.
# Free forever, no third-party account — generate your own key pair once
# with `npx web-push generate-vapid-keys` and paste both here. Works
# without these set too (dev mode: logs to the console instead of sending).
# Note: iOS Safari only delivers push to a PWA actually added to the home
# screen, not a regular browser tab — a real platform limitation, not a bug
# here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
