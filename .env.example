# ── Database (Supabase) ──────────────────────────────────────────────────
# Create a free project at https://supabase.com, run src/backend/db/schema.sql
# in its SQL editor, then copy these from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Sessions ──────────────────────────────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Signs member/admin
# login cookies. Changing it logs everyone out.
SESSION_SECRET=

# ── WhatsApp Business Cloud API ─────────────────────────────────────────
# Used for exactly five things — login/signup OTPs, the signup welcome/card
# message, fee-due reminders, birthday messages, and admin-sent offers/gym
# updates (the broadcast tool). Not sent on every profile edit or payment —
# that was intentionally scoped back. Without these vars, the app runs in
# "dev mode": OTP codes are logged to the server console (and returned in
# the API response) instead of sent over WhatsApp — everything else works
# normally. Set up via Meta Business Manager (or a BSP like Gupshup/
# AiSensy/Interakt).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional — override the default template names below if yours differ
# from what's approved in Meta Business Manager:
WHATSAPP_TEMPLATE_OTP=ff_login_otp
WHATSAPP_TEMPLATE_FEE_REMINDER=ff_fee_reminder
WHATSAPP_TEMPLATE_BIRTHDAY=ff_birthday
WHATSAPP_TEMPLATE_ANNOUNCEMENT=ff_announcement
WHATSAPP_TEMPLATE_WELCOME_CARD=ff_welcome_card

# ── Fee payments (direct UPI, no gateway/commission) ─────────────────────
# The gym's own UPI ID (e.g. "fitnessfuture@okhdfcbank") and display name.
# The member dashboard shows a QR code + tappable UPI link built from these —
# it's a direct bank-to-bank transfer, so there's no per-transaction fee like
# a payment gateway (Razorpay etc.) would charge. Since there's no gateway,
# there's no webhook either — payments are confirmed manually by staff in
# Admin → Fees → Record Manual Payment (method: UPI).
GYM_UPI_ID=
GYM_UPI_PAYEE_NAME=Fitness Future Gym

# ── Cron (Vercel Scheduled Functions) ────────────────────────────────────
# Any long random string. Vercel automatically sends it as a Bearer token
# to /api/cron/* routes when this env var is set on the project — see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
